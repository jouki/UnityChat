NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgres://postgres:password@localhost:5432/unitychat
LOG_LEVEL=debug

# Comma-separated Chrome extension IDs allowed to hit /streamers/*
# Leave empty in dev to skip the Origin check (logged as warning).
ALLOWED_EXTENSION_IDS=

# Base64-encoded 32-byte key for AES-256-GCM token encryption.
# REQUIRED for OAuth flows (Phase 3+). Leave empty to skip crypto init.
# Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Public URL the extension uses to reach this backend. Used for building
# OAuth redirect_uri values registered with providers. Example: https://api.jouki.cz
PUBLIC_BASE_URL=http://localhost:3000

# Twitch OAuth app credentials. Register at https://dev.twitch.tv/console/apps
# Redirect URL on Twitch side: {PUBLIC_BASE_URL}/streamers/oauth/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Google OAuth credentials for YouTube identity.
# Register at https://console.cloud.google.com/apis/credentials → OAuth client ID → Web application
# Authorized redirect URI: {PUBLIC_BASE_URL}/streamers/oauth/youtube/callback
# Enable YouTube Data API v3 in Google Cloud project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kick OAuth credentials. Register app at https://kick.com/settings/developer
# Kick uses OAuth 2.1 (PKCE required — handled in code).
# Redirect URL: {PUBLIC_BASE_URL}/streamers/oauth/kick/callback
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Rozšíření, na která smí přihlášení vrátit #uc_code (chrome.identity / Firefox identity).
# Chrome ID čárkami (výchozí = Chrome Web Store); unpacked vývojová instalace má jiné ID → přidat.
ALLOWED_AUTH_EXTENSION_IDS=picaeipbmkgcippknkpkbnbgjlkblbnp
# Firefox gecko ID doplňku (origin = sha1(ID).extensions.allizom.org)
ALLOWED_AUTH_FIREFOX_ADDON_IDS=unitychat@jouki.cz

# GitHub webhook /webhook/deploy (jen NODE_ENV=development). Prázdné = route se nezaregistruje.
# Generate: openssl rand -hex 32 — stejná hodnota v GitHub → Settings → Webhooks → Secret.
WEBHOOK_SECRET=

# Server-side chat log. Prázdné = ingest vypnutý (dev bez efektu).
# Formát: twitch:robdiesalot,kick:robdiesalot,youtube:robdiesalot
CHAT_INGEST_CHANNELS=
# Retence zpráv (dny), 0 = neomezeně
CHAT_RETENTION_DAYS=0

# GIFy: záložní stažení přes Bright Data Web Unlocker, když přímé narazí na Cloudflare challenge.
# Bez klíče nebo zóny = vypnuto. Klíč jen v Coolify secrets, nikdy v gitu.
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=
# Denní strop volání (reset o půlnoci UTC), výchozí 100
BRIGHTDATA_DAILY_CAP=
