# Env pro `npm test`: config.ts validuje DATABASE_URL při importu; postgres klient
# se ale nepřipojí, dokud nepřijde dotaz, takže dummy URL stačí. Integrační testy
# proti reálné DB si berou TEST_DATABASE_URL z prostředí.
NODE_ENV=test
DATABASE_URL=postgres://test:test@localhost:5432/unitychat_test
